# Protege a configuração, os dados e a pasta do Git
<Files "config.php">
  Require all denied
</Files>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^dados/ - [F,L]
  RewriteRule (^|/)\.git - [F,L]
</IfModule>
RedirectMatch 404 /\.git
Options -Indexes

# Sempre buscar a versão mais nova do app (evita cópia antiga em cache)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
